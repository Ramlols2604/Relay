# Backend only. Copy this file to backend/.env and fill it in there.
# Do not put frontend keys here. Those belong in .env.local at the repo root.
# Never commit backend/.env.
# Clerk secret key from the Clerk dashboard (starts with sk_). The browser session
# token is sent automatically. Do not paste a session token here.
# CLERK_ISSUER is the Frontend API URL, such as https://your-app.clerk.accounts.dev
CLERK_SECRET_KEY=
CLERK_ISSUER=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BACKBOARD_API_KEY=
BACKBOARD_MODEL=gemini-2.5-flash
# Order chat extraction tries LLM providers in, comma separated: any of gemini, ollama,
# backboard. Unknown names are ignored (logged); providers without the env vars above are
# skipped. Defaults to gemini,ollama,backboard when unset.
RELAY_LLM_ORDER=gemini,ollama,backboard
# Server-side Mapbox token for GET /api/geocode (shared cache). Use a SEPARATE secret
# token from the browser one — do not paste VITE_MAPBOX_ACCESS_TOKEN here. A visitor can
# copy the Vite token from the client; URL-restrict that public token to your site.
# Restrict this secret token to your API server (or leave unrestricted but never ship it
# to the browser). MAPBOX_TOKEN is accepted as an alias.
MAPBOX_ACCESS_TOKEN=
