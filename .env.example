# Frontend only. Copy this file to .env.local (gitignored) and fill it in there.
# Backend keys belong in backend/.env. The iMessage bridge uses imessage/.env.
# Clerk development keys: copy from your Clerk dashboard into .env.local.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Server-only secret: never add a VITE_ prefix. Never commit a real key.
CLERK_SECRET_KEY=sk_test_replace_me
# Relay API base URL. Leave empty for http://127.0.0.1:8000.
VITE_API_URL=
# Public Mapbox token for the Neighborhood Map GL basemap only. Create one at
# https://account.mapbox.com/ and restrict it to your dev and production URLs.
# Geocoding uses a separate secret MAPBOX_ACCESS_TOKEN in backend/.env — do not reuse
# this public token there. Never commit a real token.
VITE_MAPBOX_ACCESS_TOKEN=
